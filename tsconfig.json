{
  "compilerOptions": {
    "target": "ES2024",
    "module": "node16",
    "lib": ["ES2024"],
    "outDir": "./dist",
    "rootDir": "./src",
    "removeComments": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@/*": ["./src/*"],
      "@tests/*": ["./src/tests/*"],
      "@configs/*": ["./src/configs/*"],
      "@server/*": ["./src/server/*"],
      "@controllers/*": ["./src/controllers/*"],
      "@context/*": ["./src/context/*"],
      "@database/*": ["./src/database/*"],
      "@errors/*": ["./src/errors/*"],
      "@functions/*": ["./src/functions/*"],
      "@routes/*": ["./src/routes/*"],
      "@rules/*": ["./src/rules/*"],
      "@services/*": ["./src/services/*"],
      "@types/*": ["./src/types/*"],
      "@utils/*": ["./src/utils/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
