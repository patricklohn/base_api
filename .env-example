# Variaveis da aplicação
NODE_ENV=development
APP_NAME=base_api
APP_VERSION=1.0.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
PORT=3000
# false = API exposta diretamente | 1 = um proxy à frente (nginx/ALB) | lista de IPs/CIDRs do proxy
TRUST_PROXY=false

# Variaveis do banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=base_api_dev

# Variaveis do Supabase
# SUPABASE_DB_URL só é obrigatória quando USES_SUPABASE=true (troca a pool local pela do Supabase)
USES_SUPABASE=false
SUPABASE_DB_URL=

# Variaveis do JWT
# Mínimo de 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=60m
# Validade do refresh token em dias (rotacionado a cada uso; docs/auth.md)
REFRESH_TOKEN_EXPIRES_DAYS=30

# Variaveis CORS e Rate Limit
# Origens de navegador permitidas, separadas por vírgula ('*' libera todas). Chamadas sem Origin (servidor a servidor) sempre passam.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX_REQUESTS=10

# Variaveis da documentação
# Só tem efeito com NODE_ENV=production: true desliga /docs (Scalar) e /documentation (Swagger UI e spec JSON)
DISABLE_DOCS=true

# Variaveis do Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
