{
  "name": "base_api",
  "version": "1.0.0",
  "description": "Backend base em Node.js + TypeScript (Fastify, Zod, Kysely, PostgreSQL) com o padrão backend-node-pk",
  "main": "dist/server/index.js",
  "scripts": {
    "docker:dev": "docker compose -f infra/dev/docker-compose.yml --env-file infra/dev/.env up",
    "docker:dev:down": "docker compose -f infra/dev/docker-compose.yml --env-file infra/dev/.env down",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:fast": "tsgo -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server/index.js",
    "server:dev": "tsx watch -r tsconfig-paths/register src/server/index.ts",
    "lint": "eslint . --ext .ts",
    "lint:strict": "eslint . --ext .ts --quiet",
    "lint:fix": "eslint . --ext .ts --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "format": "prettier --write \"src/**/*.ts\"",
    "migrate:latest": "tsx src/database/db/migrate.ts",
    "migrate:down": "tsx src/database/db/migrate-down.ts",
    "migrate:seed": "tsx src/database/db/seeds.ts",
    "migrate:types": "tsx src/database/db/codegen.ts",
    "function-organization:create": "tsx src/functions/organization/create.ts",
    "function-service-account:regenerate-secret": "tsx src/functions/service-account/regenerate-secret.ts",
    "prepare": "husky"
  },
  "keywords": [
    "base_api",
    "api",
    "nodejs",
    "fastify",
    "postgresql",
    "star-wars"
  ],
  "author": "Patrick Lohn",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.1.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@scalar/fastify-api-reference": "^1.61.0",
    "@sentry/node": "^10.49.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.3.1",
    "fastify": "^5.7.4",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "kysely": "^0.28.11",
    "pg": "^8.18.0",
    "tsconfig-paths": "^4.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.16.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-check-file": "^3.3.0",
    "eslint-plugin-prettier": "^5.1.2",
    "husky": "^9.1.7",
    "kysely-codegen": "^0.20.0",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.1.1",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.24.0",
  "lint-staged": {
    "*.ts": "prettier --write"
  }
}
